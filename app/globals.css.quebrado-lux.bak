/* === LUX: REGRAS E CONCIERGE DIGITAL JARDIM BOTÂNICO === */

.lux-assistant-panel {
  display: flex;
  flex-direction: column;
  height: min(640px, calc(100dvh - 100px));
  max-height: calc(100dvh - 70px);
  background: #fcfbf8;
  border: 1px solid rgba(22, 62, 52, 0.14);
  border-radius: 18px 18px 14px 14px;
  box-shadow: 0 20px 50px -10px rgba(22, 62, 52, 0.2), 0 4px 18px rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

/* Cabeçalho Editorial */
.lux-assistant-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background: linear-gradient(180deg, #f7f5f0 0%, #f0ede6 100%);
  border-bottom: 1px solid rgba(197, 163, 104, 0.3);
}

.lux-header-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.lux-leaf-accent {
  font-size: 1.3rem;
  line-height: 1;
}

.lux-assistant-kicker {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  font-weight: 700;
  color: #163e34;
  margin: 0 0 1px 0;
}

.lux-assistant-title {
  font-family: Georgia, serif;
  font-size: 1.2rem;
  font-weight: 700;
  color: #163e34;
  margin: 0;
}

.lux-assistant-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.lux-btn-restart {
  background: rgba(22, 62, 52, 0.06);
  border: 1px solid rgba(22, 62, 52, 0.12);
  color: #163e34;
  font-size: 0.78rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.18s ease;
}

.lux-btn-restart:hover {
  background: #163e34;
  color: #ffffff;
}

.lux-assistant-close {
  background: rgba(22, 62, 52, 0.06);
  border: 1px solid rgba(22, 62, 52, 0.12);
  color: #163e34;
  font-size: 1.2rem;
  line-height: 1;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.18s ease;
}

.lux-assistant-close:hover {
  background: #163e34;
  color: #ffffff;
}

/* Status Bar */
.lux-assistant-status-bar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 18px;
  background: #f1f5f2;
  border-bottom: 1px solid rgba(22, 62, 52, 0.06);
}

.lux-status-info {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.76rem;
  color: #3b5249;
  font-weight: 500;
}

.lux-status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #c5a368;
  box-shadow: 0 0 0 2px rgba(197, 163, 104, 0.3);
}

.lux-status-dot.state-listening {
  background: #2e7d32;
  box-shadow: 0 0 0 2px rgba(46, 125, 50, 0.3);
}

.lux-status-dot.state-thinking {
  background: #c5a368;
  animation: lux-pulse 1.2s infinite ease-in-out;
}

@keyframes lux-pulse {
  0%, 100% { opacity: 0.4; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.15); }
}

/* Área de Log de Mensagens */
.lux-assistant-log {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* Cartões de Mensagem */
.lux-message {
  max-width: 88%;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.lux-message.is-assistant {
  align-self: flex-start;
  background: #ffffff;
  border: 1px solid rgba(22, 62, 52, 0.1);
  border-left: 3px solid #163e34;
  border-radius: 4px 14px 14px 14px;
  padding: 12px 14px;
  box-shadow: 0 2px 8px rgba(22, 62, 52, 0.04);
}

.lux-message-header {
  display: flex;
  align-items: center;
  margin-bottom: 2px;
}

.lux-avatar-badge {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #163e34;
}

.lux-message.is-user {
  align-self: flex-end;
  background: #163e34;
  color: #fcfbf8;
  border-radius: 14px 14px 4px 14px;
  padding: 10px 14px;
  box-shadow: 0 2px 6px rgba(22, 62, 52, 0.15);
}

.lux-message-text {
  white-space: pre-wrap;
  word-break: break-word;
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.45;
}

.lux-message.is-user .lux-message-text {
  color: #fcfbf8;
}

/* Thinking Indicator */
.lux-thinking {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 8px;
  background: #f1f6f2;
  border: 1px solid rgba(22, 62, 52, 0.08);
  border-radius: 16px;
  padding: 8px 14px;
  margin-top: 4px;
}

.lux-thinking-dots {
  display: flex;
  gap: 4px;
}

.lux-thinking-dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #163e34;
  opacity: 0.4;
  animation: lux-bounce 1.4s infinite ease-in-out both;
}

.lux-thinking-dots span:nth-child(1) { animation-delay: 0s; }
.lux-thinking-dots span:nth-child(2) { animation-delay: 0.2s; }
.lux-thinking-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes lux-bounce {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.3; }
  40% { transform: scale(1.1); opacity: 1; }
}

.lux-thinking-text {
  font-size: 0.78rem;
  color: #3b5249;
  font-weight: 500;
}

/* Quick Replies */
.lux-quick-replies {
  flex: 0 0 auto;
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 8px 16px;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

.lux-quick-replies::-webkit-scrollbar {
  height: 3px;
}

.lux-quick-replies::-webkit-scrollbar-thumb {
  background: rgba(22, 62, 52, 0.15);
  border-radius: 3px;
}

.lux-quick-replies button {
  flex: 0 0 auto;
  white-space: nowrap;
  background: #f2f6f3;
  border: 1px solid rgba(22, 62, 52, 0.15);
  color: #163e34;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 18px;
  cursor: pointer;
  transition: all 0.18s ease;
}

.lux-quick-replies button:hover:not(:disabled) {
  background: #163e34;
  color: #ffffff;
  border-color: #163e34;
}

/* Rodapé e Composer */
.lux-assistant-footer {
  flex: 0 0 auto;
  flex-shrink: 0;
  position: relative;
  z-index: 5;
  width: 100%;
  background: #f7f5f0;
  border-top: 1px solid rgba(197, 163, 104, 0.25);
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lux-footer-top {
  display: flex;
  justify-content: flex-end;
}

.lux-whatsapp-secondary {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  font-weight: 600;
  color: #163e34;
  background: rgba(22, 62, 52, 0.05);
  border: 1px solid rgba(22, 62, 52, 0.12);
  padding: 4px 10px;
  border-radius: 10px;
  text-decoration: none;
  transition: all 0.18s ease;
}

.lux-whatsapp-secondary:hover {
  background: #163e34;
  color: #ffffff;
}

.lux-composer {
  width: 100%;
}

.lux-composer-inner {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(22, 62, 52, 0.2);
  border-radius: 22px;
  padding: 3px 4px 3px 14px;
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.lux-composer-inner:focus-within {
  border-color: #163e34;
  box-shadow: 0 0 0 3px rgba(22, 62, 52, 0.12);
}

.lux-composer input {
  flex: 1 1 auto;
  min-width: 0;
  border: none;
  background: transparent;
  font-size: 0.88rem;
  color: #1b2823;
  outline: none;
}

.lux-composer input::placeholder {
  color: #788a82;
}

.lux-composer-submit {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #163e34;
  color: #ffffff;
  border: none;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 18px;
  cursor: pointer;
  transition: opacity 0.18s ease, background-color 0.18s ease;
}

.lux-composer-submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.lux-privacy-note {
  font-size: 0.68rem;
  color: #6b7c75;
  text-align: center;
  margin: 2px 0 0 0;
}

@media (min-width: 760px) {
  .lux-assistant-panel {
    height: min(660px, calc(100dvh - 140px));
  }
}

/* === FIM: CONCIERGE LUX === */